#!/usr/bin/env bash
# Global pope CLI - install this once (put this file's directory on PATH)
# and `pope install`/`pope propath`/`pope registry add` work from inside
# ANY pope-managed project, no per-project ".\pope"/"./pope" needed.
#
# Unlike the per-project pope/pope.bat (copied into each scaffolded
# project by scaffoldProject, which finds its target project via its OWN
# file location - %~dp0/${BASH_SOURCE[0]}'s directory), this script finds
# its target project from your CURRENT WORKING DIRECTORY, walking upward
# looking for openedge-project.json - the same way git/npm find their
# project root from any subfolder. That's what makes it safe to put on
# PATH: it always operates on whatever project you're actually standing
# in, never on wherever this script itself happens to be installed.
#
# The per-project pope/pope.bat still exist and still matter - they're
# what makes a project fully self-contained and usable without any global
# setup (e.g. in CI, or on a machine where this hasn't been installed).
# This is a local-dev convenience layered on top, not a replacement.
set -e

find_project_root() {
    local dir="$PWD"
    while true; do
        if [ -f "$dir/openedge-project.json" ]; then
            echo "$dir"
            return 0
        fi
        local parent
        parent="$(dirname "$dir")"
        [ "$parent" = "$dir" ] && return 1
        dir="$parent"
    done
}

PROJECT_ROOT="$(find_project_root)" || {
    echo "Not inside a pope project - no openedge-project.json found in $PWD or any parent directory." >&2
    exit 1
}

# Two layouts a scaffolded project can be in: Gradle's own files tucked
# into .pope/ (new projects), or at the project root (legacy - e.g. the
# real openedge-package-manager demo repo, which predates the .pope/
# layout). Detected automatically so this one script works for both.
if [ -f "$PROJECT_ROOT/.pope/gradlew" ]; then
    GRADLEW="$PROJECT_ROOT/.pope/gradlew"
    PROJECT_DIR_ARGS=(-p "$PROJECT_ROOT/.pope")
else
    GRADLEW="$PROJECT_ROOT/gradlew"
    PROJECT_DIR_ARGS=()
fi

if [ ! -x "$GRADLEW" ]; then
    echo "Found $PROJECT_ROOT/openedge-project.json, but no gradlew there (or in .pope/) - is this really a pope project?" >&2
    exit 1
fi

run_gradle() {
    set +e
    "$GRADLEW" "${PROJECT_DIR_ARGS[@]}" "$@"
    local status=$?
    set -e
    echo
    return $status
}

usage() {
    echo "Usage (running against $PROJECT_ROOT):"
    echo "  pope install                          resolve declared dependencies"
    echo "  pope install <package>[:<versionSpec>] add + resolve a dependency in one step"
    echo "  pope uninstall <package>               remove a dependency and clean up its files"
    echo "  pope propath [--tests]                 print the generated PROPATH"
    echo "                                          (--tests also includes buildPath's \"test\" entries)"
    echo "  pope registry add [<prefix> <url> [<name>]]  add a registry to pope-registries.properties"
    echo "                                          (interactive if prefix/url are omitted)"
    echo "  pope prune [--dry-run]                 remove pope_packages/ entries no longer part of"
    echo "                                          the resolved dependency graph"
    exit 1
}

[ "$#" -ge 1 ] || usage

command="$1"
shift

case "$command" in
    install)
        if [ "$#" -eq 0 ]; then
            run_gradle popeInstall
        elif [ "$#" -eq 1 ]; then
            run_gradle popeInstall "-PpopeAdd=$1"
        else
            usage
        fi
        ;;
    uninstall)
        if [ "$#" -eq 1 ]; then
            run_gradle popeUninstall "-PpopeUninstall=$1"
        else
            usage
        fi
        ;;
    propath)
        if [ "$#" -eq 0 ]; then
            run_gradle popePropath
        elif [ "$#" -eq 1 ] && [ "$1" = "--tests" ]; then
            run_gradle popePropath -PpopeIncludeTests
        else
            usage
        fi
        ;;
    registry)
        [ "${1:-}" = "add" ] || usage
        shift
        if [ "$#" -eq 0 ]; then
            read -r -p "Registry prefix (e.g. ba): " prefix
            [ -n "$prefix" ] || { echo "Registry prefix is required."; exit 1; }
            read -r -p "Catalog URL: " url
            [ -n "$url" ] || { echo "Catalog URL is required."; exit 1; }
            run_gradle popeRegistryAdd "-PregistryPrefix=$prefix" "-PcatalogUrl=$url"
        elif [ "$#" -eq 2 ]; then
            run_gradle popeRegistryAdd "-PregistryPrefix=$1" "-PcatalogUrl=$2"
        elif [ "$#" -eq 3 ]; then
            run_gradle popeRegistryAdd "-PregistryPrefix=$1" "-PcatalogUrl=$2" "-PregistryName=$3"
        else
            usage
        fi
        ;;
    prune)
        if [ "$#" -eq 0 ]; then
            run_gradle popePrune
        elif [ "$#" -eq 1 ] && [ "$1" = "--dry-run" ]; then
            run_gradle popePrune -PpopeDryRun
        else
            usage
        fi
        ;;
    *)
        usage
        ;;
esac
