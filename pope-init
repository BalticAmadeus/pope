#!/usr/bin/env bash
# Interactively adds pope wiring to the current directory (your project -
# new or existing). Run this FROM your project's own directory, pointing
# at wherever you cloned pope:
#   /path/to/pope/pope-init
# Prompts for registries, then delegates to pope's own scaffoldProject
# Gradle task (see build.gradle.kts) to actually write/patch files.
set -e
set -o pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$(pwd)"

# Loops on anything but yes/y/no/n rather than silently defaulting either
# way on a typo - matches how the direct-source trust prompt behaves.
ask_yes_no() {
    local prompt="$1" answer
    while true; do
        read -r -p "$prompt [yes/no]: " answer
        case "$answer" in
            [yY] | [yY][eE][sS]) return 0 ;;
            [nN] | [nN][oO]) return 1 ;;
            *) echo "Please enter 'yes' or 'no'." ;;
        esac
    done
}

registries=""
while true; do
    read -r -p "Registry prefix (e.g. ba), or leave blank to stop adding registries: " prefix
    [ -z "$prefix" ] && break

    read -r -p "Catalog URL for \"$prefix\": " url
    if [ -z "$url" ]; then
        echo "No URL given, skipping this registry."
        continue
    fi

    if [ -n "$registries" ]; then
        registries="$registries,$prefix=$url"
    else
        registries="$prefix=$url"
    fi

    ask_yes_no "Add another registry?" || break
done

run_scaffold() {
    "$TOOL_DIR/gradlew" -p "$TOOL_DIR" scaffoldProject \
        -PtargetDir="$TARGET_DIR" \
        ${registries:+-Pregistries="$registries"} \
        "$@"
}

offer_global_cli() {
    # Already on PATH? Don't ask - just say so and move on, rather than
    # asking a question whose answer install.sh would report after the fact.
    if "$TOOL_DIR/cli/install.sh" --check; then
        echo "(global pope CLI is already set up - \"pope install\" already works from any project)"
        return
    fi
    if ask_yes_no "Add the global pope CLI to PATH, so \"pope install\" works from any project without ./pope?"; then
        "$TOOL_DIR/cli/install.sh"
    fi
}

finish() {
    offer_global_cli
    exit 0
}

output_file="$(mktemp)"
if run_scaffold 2>&1 | tee "$output_file"; then
    rm -f "$output_file"
    finish
fi

if grep -q "PACKAGE_NAME_REQUIRED" "$output_file"; then
    rm -f "$output_file"
    echo
    echo "Couldn't automatically determine package_name for your project."
    read -r -p "Enter package_name (e.g. example.myproject): " package_name
    [ -n "$package_name" ] || { echo "package_name is required."; exit 1; }
    run_scaffold "-PpackageName=$package_name" && finish
else
    rm -f "$output_file"
    exit 1
fi
