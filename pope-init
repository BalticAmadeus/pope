#!/usr/bin/env bash
# Bootstraps pope into the CURRENT directory (your project - new or
# existing), with NO local clone of pope needed: this script is meant to
# be downloaded once (e.g. curl'd from GitHub) and run from inside your
# project. It writes just enough to resolve pope from its published
# Maven repo (https://balticamadeus.github.io/pope/) - the Gradle
# wrapper, settings.gradle.kts, build.gradle.kts - then lets Gradle pull
# the plugin itself and finish setup via the popeInit task (which does
# what this script can't: read pope's own code to infer package_name,
# etc.). See docs/decisions/0008-plugin-publishing-v1.md for why.
set -e
set -o pipefail

POPE_REPO_RAW="https://raw.githubusercontent.com/BalticAmadeus/pope/main"
TARGET_DIR="$(pwd)"

ask_yes_no() {
    local prompt="$1" answer
    while true; do
        read -r -p "$prompt [yes/no]: " answer
        case "$answer" in
            [yY] | [yY][eE][sS]) return 0 ;;
            [nN] | [nN][oO]) return 1 ;;
            *) echo "Please enter 'yes' or 'no'." ;;
        esac
    done
}

POPE_VERSION="${1:-}"
if [ -z "$POPE_VERSION" ]; then
    read -r -p "pope version to use (see https://github.com/BalticAmadeus/pope/releases): " POPE_VERSION
    [ -n "$POPE_VERSION" ] || { echo "A version is required."; exit 1; }
fi

registries=""
while true; do
    read -r -p "Registry prefix (e.g. ba), or leave blank to stop adding registries: " prefix
    [ -z "$prefix" ] && break

    read -r -p "Catalog URL for \"$prefix\": " url
    if [ -z "$url" ]; then
        echo "No URL given, skipping this registry."
        continue
    fi

    registries="$registries|$prefix=$url"
    ask_yes_no "Add another registry?" || break
done

echo "Fetching the Gradle wrapper..."
mkdir -p gradle/wrapper
curl -fsSL "$POPE_REPO_RAW/gradlew" -o gradlew
chmod +x gradlew
curl -fsSL "$POPE_REPO_RAW/gradlew.bat" -o gradlew.bat
curl -fsSL "$POPE_REPO_RAW/gradle/wrapper/gradle-wrapper.jar" -o gradle/wrapper/gradle-wrapper.jar
curl -fsSL "$POPE_REPO_RAW/gradle/wrapper/gradle-wrapper.properties" -o gradle/wrapper/gradle-wrapper.properties

if [ ! -f settings.gradle.kts ]; then
    root_project_name="$(basename "$TARGET_DIR")"
    cat > settings.gradle.kts <<EOF
pluginManagement {
    // pope is resolved by coordinate from its published Maven repo - the
    // maven-repo branch of github.com/BalticAmadeus/pope, served over
    // GitHub Pages. No local clone, no machine-specific path.
    repositories {
        maven {
            url = uri("https://balticamadeus.github.io/pope/")
        }
        gradlePluginPortal()
    }
}

rootProject.name = "$root_project_name"
EOF
else
    echo "  settings.gradle.kts already exists - left untouched. Needs a pluginManagement{} repositories{}"
    echo "  block pointing at https://balticamadeus.github.io/pope/"
fi

if [ ! -f build.gradle.kts ]; then
    cat > build.gradle.kts <<EOF
plugins {
    id("io.github.balticamadeus.pope") version "$POPE_VERSION"
}
EOF
else
    echo "  build.gradle.kts already exists - left untouched. Needs"
    echo "  id(\"io.github.balticamadeus.pope\") version \"$POPE_VERSION\" applied."
fi

run_pope_init() {
    ./gradlew popeInit "$@"
}

output_file="$(mktemp)"
if run_pope_init 2>&1 | tee "$output_file"; then
    init_ok=1
else
    init_ok=0
fi

if [ "$init_ok" != "1" ] && grep -q "Could not infer package_name" "$output_file"; then
    echo
    echo "Couldn't automatically determine the package name for your project."
    read -r -p "Enter it now (e.g. example.myproject): " package_name
    [ -n "$package_name" ] || { echo "A package name is required."; rm -f "$output_file"; exit 1; }
    rm -f "$output_file"
    run_pope_init "-PpopePackageName=$package_name"
else
    rm -f "$output_file"
    [ "$init_ok" = "1" ] || exit 1
fi

if [ -n "$registries" ]; then
    IFS='|' read -ra entries <<< "${registries#|}"
    for entry in "${entries[@]}"; do
        prefix="${entry%%=*}"
        url="${entry#*=}"
        ./gradlew popeRegistryAdd "-PregistryPrefix=$prefix" "-PcatalogUrl=$url"
    done
fi

offer_global_cli() {
    local cli_dir="$HOME/.pope/cli"
    mkdir -p "$cli_dir"
    curl -fsSL "$POPE_REPO_RAW/cli/pope" -o "$cli_dir/pope"
    chmod +x "$cli_dir/pope"
    curl -fsSL "$POPE_REPO_RAW/cli/install.sh" -o "$cli_dir/install.sh"
    chmod +x "$cli_dir/install.sh"

    # Already on PATH? Don't ask - just say so, rather than asking a
    # question whose answer install.sh would report after the fact.
    if "$cli_dir/install.sh" --check; then
        echo "(global pope CLI is already set up - \"pope install\" already works from any project)"
        return
    fi
    if ask_yes_no "Add the global pope CLI to PATH, so \"pope install\" works from any project without ./gradlew?"; then
        "$cli_dir/install.sh"
    fi
}

offer_global_cli
